# Variables del frontend de PokéArena.
# Copie este archivo como .env.local (Git lo ignora) y ponga los valores reales.
#
# Client ID de la aplicación PokéArena en Google Cloud Console. Debe ser EXACTAMENTE
# el mismo que Authentication:Google:ClientId de la API. No es secreto: Google lo
# muestra en el navegador al dibujar el botón.
VITE_GOOGLE_CLIENT_ID=
